# ===========================================
# 環境変数雛形 - コピーして .env.local で使用
# ===========================================

# --- Next.js ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Sheets API（サービスアカウント）---
# スプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOOGLE_SHEETS_SPREADSHEET_ID=

# 認証方法のいずれか一方を設定

# 方法1: サービスアカウントJSONを文字列で指定（Vercel等で推奨）
# ダウンロードしたJSONを1行にまとめて貼り付け
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...",...}

# 方法2: 認証JSONファイルのパス（ローカル開発で推奨）
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# 車両追加時にDriveにフォルダを作る親フォルダID（任意）
# 未設定の場合はサービスアカウントのDriveルートに作成されます。
# GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- Anthropic API（BDS 個票査定 /api/assess）---
# https://console.anthropic.com/ で API キーを発行
# ANTHROPIC_API_KEY=

# --- Gemini API（BDS 査定・AI）---
# Google AI Studio で API キーを発行: https://aistudio.google.com/apikey
# GOOGLE_GEMINI_API_KEY=
# モデル（省略時は gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# --- 為替（eBay 円換算）---
# 取得失敗時のフォールバック USD/JPY（省略時は 150）
# FALLBACK_USD_JPY=150

# --- ヤフオク出品モニター ---
# 出品者ID（サイドバーで出品中一覧を表示する際に使用）
# YAHOO_AUCTION_ID=

# --- ブックマークレット API (/api/vehicles/bookmarklet) ---
# リクエストヘッダー X-GAMI-API-KEY と一致する値。未設定時は既定キーを使用
# GAMI_BOOKMARKLET_API_KEY=

# --- Supabase (Postgres) ---
# プロジェクトの URL（Supabase ダッシュボード > Settings > API）
NEXT_PUBLIC_SUPABASE_URL=
# サービスロールキー（サーバー専用・絶対にクライアントに露出しない）
SUPABASE_SERVICE_ROLE_KEY=
# 匿名キー（ブラウザ用。市場価格・在庫など lib/api 経由の取得に必要）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 買取査定Bot (LINE Messaging API) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
